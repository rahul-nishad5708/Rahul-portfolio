# Public canonical site URL (used for SEO metadata, Open Graph, and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side contact form email delivery via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=your-email@example.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional: Shared / Distributed Rate Limiting via Upstash Redis (https://upstash.com)
# When provided, Upstash handles global sliding-window rate limiting across all serverless regions.
# If omitted, a persistent file-backed store is used automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
